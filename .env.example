# Optional Supabase production adapter (the MVP runs in seeded local demo mode without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only used by `npm run claim:create` (scripts/create-claim-link.ts) when printing a one-time
# owner claim link. Defaults to https://your-deployment.example if unset.
SITE_URL=

# Server-side only — never exposed to browser code. Sends the one-time
# post-claim owner welcome email (lib/data/welcome-email.ts). If unset, a
# successful ownership claim still succeeds; the welcome email is logged as
# failed and retried automatically next time the owner visits /owner.
RESEND_API_KEY=

# Optional. Preview/testing can use the Resend development sender, e.g.
# "Trade Site Builder <onboarding@resend.dev>". Defaults to that value if unset.
OWNER_EMAIL_FROM=


